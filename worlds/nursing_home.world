<?xml version="1.0"?>
<sdf version="1.9">
  <world name="nursing_home">

    <!-- Gazebo Harmonic 必需 Systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 场景设置 -->
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.7 0.8 1.0 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- 主光源 - 模拟阳光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
      <intensity>1.0</intensity>
    </light>

    <!-- 补充光源 -->
    <light type="directional" name="ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.7 0.7 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 -0.3 -0.8</direction>
      <intensity>0.8</intensity>
    </light>

    <!-- 额外补光 - 从另一侧 -->
    <light type="directional" name="fill_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 0.5 -0.7</direction>
      <intensity>0.6</intensity>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.75 0.7 1</ambient>
            <diffuse>0.8 0.85 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 物理引擎 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 前台桌子 -->
    <model name="reception_desk">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 1 1</size></box></geometry>
          <material>
            <ambient>0.8 0.5 0.2 1</ambient>
            <diffuse>0.9 0.6 0.3 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 药品架 -->
    <model name="medicine_shelf">
      <static>true</static>
      <pose>1.5 -0.8 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 0.4 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.4 1.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 建筑外墙 -->
    <model name="building_walls">
      <static>true</static>
      <link name="north_wall">
        <pose>0 10 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>30 0.2 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 0.2 3</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.95 0.95 0.9 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>0 -10 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>30 0.2 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 0.2 3</size></box></geometry>
          <material>
            <ambient>0.95 0.92 0.85 1</ambient>
            <diffuse>1.0 0.97 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="east_wall">
        <pose>15 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 3</size></box></geometry>
          <material>
            <ambient>0.95 0.92 0.85 1</ambient>
            <diffuse>1.0 0.97 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="west_wall">
        <pose>-15 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 3</size></box></geometry>
          <material>
            <ambient>0.95 0.92 0.85 1</ambient>
            <diffuse>1.0 0.97 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 房间101 (带床和床头柜) -->
    <model name="room_101">
      <static>true</static>
      <pose>10 5 0 0 0 0</pose>
      <link name="wall_north">
        <pose>0 2.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5 0.1 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 0.1 3</size></box></geometry>
          <material>
            <ambient>0.85 0.9 0.95 1</ambient>
            <diffuse>0.9 0.95 1.0 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>1 -2.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3 0.1 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 0.1 3</size></box></geometry>
          <material>
            <ambient>0.85 0.9 0.95 1</ambient>
            <diffuse>0.9 0.95 1.0 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>2.5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-2.5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="bed">
        <pose>1.5 1 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2 1 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 1 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.8 1 1</ambient>
            <diffuse>0.7 0.85 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <link name="nightstand">
        <pose>0.2 1 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5 0.4 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.4 0.6</size></box></geometry>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- 房间102 -->
    <model name="room_102">
      <static>true</static>
      <pose>10 -5 0 0 0 0</pose>
      <link name="wall_north">
        <pose>1 2.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3 0.1 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 0.1 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>0 -2.5 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5 0.1 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 0.1 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>2.5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-2.5 0 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5 3</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.9 1</ambient>
            <diffuse>0.98 0.98 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="bed">
        <pose>1.5 -1 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2 1 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 1 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.8 1 1</ambient>
            <diffuse>0.7 0.85 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <link name="nightstand">
        <pose>0.2 -1 0.3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5 0.4 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.4 0.6</size></box></geometry>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- 电梯井 -->
    <model name="elevator_shaft">
      <static>true</static>
      <pose>-5 0 0 0 0 0</pose>
      <link name="shaft_wall_n">
        <pose>0 1.5 3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2 0.1 6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 0.1 6</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="shaft_wall_s">
        <pose>0 -1.5 3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2 0.1 6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 0.1 6</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="shaft_wall_e">
        <pose>1 0 3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 3 6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3 6</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="shaft_wall_w">
        <pose>-1 0 3 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 3 6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3 6</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 电梯轿厢 -->
    <model name="elevator_car">
      <pose>-5 0 0.1 0 0 0</pose>
      <link name="platform">
        <inertial>
          <mass>200</mass>
          <inertia><ixx>50</ixx><iyy>50</iyy><izz>50</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>1.8 2.8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 2.8 0.1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <link name="wall_back">
        <pose>-0.9 0 1.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 2.8 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 2.8 2.4</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 走廊 -->
    <model name="corridor_floor">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 18 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 18 0.02</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.88 1</ambient>
            <diffuse>0.98 0.98 0.94 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
