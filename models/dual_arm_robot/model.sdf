      </axis>
    </joint>
    <!-- 左手爪 -->
    <link name="left_gripper">
      <pose relative_to="left_gripper_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 0 -0.02 0 0 0</pose>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
