    <!-- 左手腕 -->
    <link name="left_wrist">
      <pose relative_to="left_wrist_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
