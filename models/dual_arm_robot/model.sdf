        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="left_shoulder_collision">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
      </collision>
    </link>
    <joint name="left_shoulder_joint" type="revolute">
      <pose relative_to="torso">0 0.32 0.5 0 0 0</pose>
      <parent>torso</parent>
      <child>left_shoulder</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>50</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    <!-- 左上臂 -->
    <link name="left_upper_arm">
      <pose relative_to="left_upper_arm_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <pose>0 0 -0.15 0 0 0</pose>
        <inertia>
          <ixx>0.008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.008</iyy>
          <iyz>0</iyz>
          <izz>0.0005</izz>
