          <cylinder>
            <radius>0.04</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="left_upper_arm_joint" type="revolute">
      <pose relative_to="left_shoulder">0 0 0 0 0 0</pose>
      <parent>left_shoulder</parent>
      <child>left_upper_arm</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>50</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
