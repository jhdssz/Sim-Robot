    </link>
    <joint name="left_elbow_joint" type="revolute">
      <pose relative_to="left_upper_arm">0 0 -0.3 0 0 0</pose>
      <parent>left_upper_arm</parent>
      <child>left_elbow</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>2.5</upper>
          <effort>30</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    <!-- 左前臂 -->
    <link name="left_forearm">
      <pose relative_to="left_forearm_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <pose>0 0 -0.12 0 0 0</pose>
        <inertia>
          <ixx>0.0025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0025</iyy>
          <iyz>0</iyz>
          <izz>0.0003</izz>
        </inertia>
