      <pose relative_to="base_link">0 0 0.235 0 0 0</pose>
      <parent>base_link</parent>
      <child>laser_support</child>
    </joint>
    <link name="camera_link">
      <pose relative_to="camera_link_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.08 0.05</size>
          </box>
        </geometry>
      </visual>
      <collision name="camera_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.08 0.05</size>
          </box>
        </geometry>
      </collision>
      <sensor name="front_camera" type="camera">
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_link_joint" type="fixed">
      <pose relative_to="torso">0.20 0 0.65 0 0 0</pose>
      <parent>torso</parent>
      <child>camera_link</child>
    </joint>
    <link name="camera_optical_frame">
      <pose relative_to="camera_optical_frame_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <iyy>1e-06</iyy>
          <izz>1e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
