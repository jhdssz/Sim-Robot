            <radius>0.001</radius>
          </sphere>
        </geometry>
      </collision>
    </link>
    <joint name="camera_optical_frame_joint" type="fixed">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
      <parent>camera_link</parent>
      <child>camera_optical_frame</child>
    </joint>
    <!-- Force-based position control for both 6-DOF arms and fingers. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_shoulder_joint</joint_name>
      <topic>/dual_arm_robot/left_shoulder_joint/command</topic>
      <p_gain>80</p_gain>
      <i_gain>0</i_gain>
      <d_gain>8</d_gain>
      <cmd_max>50</cmd_max>
      <cmd_min>-50</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_upper_arm_joint</joint_name>
      <topic>/dual_arm_robot/left_upper_arm_joint/command</topic>
      <p_gain>80</p_gain>
      <i_gain>0</i_gain>
      <d_gain>8</d_gain>
      <cmd_max>50</cmd_max>
      <cmd_min>-50</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
