            <length>0.24</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="left_forearm_joint" type="revolute">
      <pose relative_to="left_elbow">0 0 0 0 0 0</pose>
      <parent>left_elbow</parent>
      <child>left_forearm</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>20</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
