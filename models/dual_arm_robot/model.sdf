    <!-- 右肘 -->
    <link name="right_elbow">
      <pose relative_to="right_elbow_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0003</iyy>
