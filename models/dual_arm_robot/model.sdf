        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="left_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
    <!-- 右后轮 -->
    <link name="right_rear_wheel">
      <pose>-0.2 -0.25 0 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="right_rear_wheel_visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="right_rear_wheel_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="right_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
    <!-- 躯干 -->
    <link name="torso">
      <pose>0 0 0.2 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <pose>0 0 0.3268 0 0 0</pose>
        <inertia>
          <ixx>0.350474058333</ixx>
          <iyy>0.350474058333</iyy>
          <izz>0.15488625</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Open scan bay: base z=0.22..0.32; columns retain structural support. -->
      <visual name="torso_upper_visual">
        <pose>0 0 0.36 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_upper_collision">
        <pose>0 0 0.36 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.48</size>
          </box>
        </geometry>
      </collision>
      <visual name="torso_lower_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_lower_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="torso_post_1_visual">
        <pose>-0.125 -0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_post_1_collision">
        <pose>-0.125 -0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="torso_post_2_visual">
        <pose>-0.125 0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_post_2_collision">
        <pose>-0.125 0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="torso_post_3_visual">
        <pose>0.125 -0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_post_3_collision">
        <pose>0.125 -0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="torso_post_4_visual">
        <pose>0.125 0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="torso_post_4_collision">
        <pose>0.125 0.125 0.07 0 0 0</pose>
        <geometry>
          <box>
            <size>0.015 0.015 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>
    <joint name="torso_joint" type="fixed">
      <parent>base_link</parent>
      <child>torso</child>
    </joint>
    <!-- LiDAR 激光雷达 -->
    <link name="laser_link">
      <pose relative_to="laser_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="laser_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="laser_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <!-- GPU LiDAR 传感器 -->
      <sensor name="laser_sensor" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="laser_joint" type="fixed">
      <pose relative_to="base_link">0 0 0.27 0 0 0</pose>
      <parent>base_link</parent>
      <child>laser_link</child>
    </joint>
    <!-- 左臂完整版本 -->
    <link name="left_shoulder">
      <pose relative_to="left_shoulder_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="left_shoulder_visual">
        <geometry>
          <sphere>
            <radius>0.06</radius>
