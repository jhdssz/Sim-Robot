      <pose relative_to="left_wrist">0 0 0 0 0 0</pose>
      <parent>left_wrist</parent>
      <child>left_gripper</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>10</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    <!-- 右臂完整版本 -->
    <link name="right_shoulder">
      <pose relative_to="right_shoulder_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
