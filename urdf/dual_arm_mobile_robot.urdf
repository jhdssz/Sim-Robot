<?xml version='1.0' encoding='utf-8'?>
<robot name="dual_arm_mobile_robot">
  <!-- 底盘 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.6 0.4 0.2" />
      </geometry>
      <material name="base_color">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.6 0.4 0.2" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20" />
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.7" iyz="0" izz="0.8" />
    </inertial>
  </link>
  <!-- 左前轮 -->
  <link name="left_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_front_wheel" />
    <origin xyz="0.2 0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <!-- 右前轮 -->
  <link name="right_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_front_wheel" />
    <origin xyz="0.2 -0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <!-- 左后轮 -->
  <link name="left_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
      <material name="wheel_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_rear_wheel" />
    <origin xyz="-0.2 0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <!-- 右后轮 -->
  <link name="right_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
      <material name="wheel_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_rear_wheel" />
    <origin xyz="-0.2 -0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>
  <!-- 躯干 -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0.3268" rpy="0 0 0" />
      <mass value="10" />
      <inertia ixx="0.350474058333" iyy="0.350474058333" izz="0.15488625" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <!-- Open scan bay: base z=0.22..0.32; matches SDF collision and inertia. -->
    <visual>
      <origin xyz="0 0 0.36" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.48" />
      </geometry>
      <material name="torso_color">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.36" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.48" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.02" />
      </geometry>
      <material name="torso_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.02" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.125 -0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
      <material name="torso_color" />
    </visual>
    <collision>
      <origin xyz="-0.125 -0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.125 0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
      <material name="torso_color" />
    </visual>
    <collision>
      <origin xyz="-0.125 0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.125 -0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
      <material name="torso_color" />
    </visual>
    <collision>
      <origin xyz="0.125 -0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.125 0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
      <material name="torso_color" />
    </visual>
    <collision>
      <origin xyz="0.125 0.125 0.07" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso" />
    <origin xyz="0 0 0.2" rpy="0 0 0" />
  </joint>
  <!-- 左臂 -->
  <!-- 左肩 -->
  <link name="left_shoulder">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
      <material name="joint_color">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="left_shoulder_joint" type="revolute">
    <parent link="torso" />
    <child link="left_shoulder" />
    <origin xyz="0 0.32 0.5" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="50" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 左上臂 -->
  <link name="left_upper_arm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.3" />
      </geometry>
      <material name="arm_color">
        <color rgba="0.7 0.7 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="left_upper_arm_joint" type="revolute">
    <parent link="left_shoulder" />
    <child link="left_upper_arm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="50" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 左肘 -->
  <link name="left_elbow">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="joint_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>
  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_upper_arm" />
    <child link="left_elbow" />
    <origin xyz="0 0 -0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="2.5" effort="30" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 左前臂 -->
  <link name="left_forearm">
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.24" />
      </geometry>
      <material name="arm_color" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.24" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0003" />
    </inertial>
  </link>
  <joint name="left_forearm_joint" type="revolute">
    <parent link="left_elbow" />
    <child link="left_forearm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="20" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 左手腕 -->
  <link name="left_wrist">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="joint_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
  </link>
  <joint name="left_wrist_joint" type="revolute">
    <parent link="left_forearm" />
    <child link="left_wrist" />
    <origin xyz="0 0 -0.24" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="20" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 左手爪 -->
  <link name="left_gripper">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.04" />
      </geometry>
      <material name="gripper_color">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="left_gripper_joint" type="revolute">
    <parent link="left_wrist" />
    <child link="left_gripper" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右臂 (镜像左臂) -->
  <!-- 右肩 -->
  <link name="right_shoulder">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
      <material name="joint_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="right_shoulder_joint" type="revolute">
    <parent link="torso" />
    <child link="right_shoulder" />
    <origin xyz="0 -0.32 0.5" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="50" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右上臂 -->
  <link name="right_upper_arm">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.3" />
      </geometry>
      <material name="arm_color" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="right_upper_arm_joint" type="revolute">
    <parent link="right_shoulder" />
    <child link="right_upper_arm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="50" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右肘 -->
  <link name="right_elbow">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="joint_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm" />
    <child link="right_elbow" />
    <origin xyz="0 0 -0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="2.5" effort="30" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右前臂 -->
  <link name="right_forearm">
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.24" />
      </geometry>
      <material name="arm_color" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.24" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.12" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0003" />
    </inertial>
  </link>
  <joint name="right_forearm_joint" type="revolute">
    <parent link="right_elbow" />
    <child link="right_forearm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="20" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右手腕 -->
  <link name="right_wrist">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="joint_color" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
  </link>
  <joint name="right_wrist_joint" type="revolute">
    <parent link="right_forearm" />
    <child link="right_wrist" />
    <origin xyz="0 0 -0.24" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="20" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- 右手爪 -->
  <link name="right_gripper">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.04" />
      </geometry>
      <material name="gripper_color" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="right_gripper_joint" type="revolute">
    <parent link="right_wrist" />
    <child link="right_gripper" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="0.8" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <!-- LiDAR 激光雷达 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
      <material name="laser_color">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0 0 0.27" rpy="0 0 0" />
  </joint>
  <!-- Gazebo Harmonic 插件 (ros_gz) -->
  <gazebo>
    <!-- 差速驱动控制器 -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <wheel_diameter>0.2</wheel_diameter>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/odom_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- Joint State Publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- Pose Publisher -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
    </plugin>
  </gazebo>
  <!-- LiDAR 传感器 Gazebo 配置 -->
  <gazebo reference="laser_link">
    <sensor name="laser_sensor" type="gpu_lidar">
      <gz_frame_id>laser_link</gz_frame_id>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <link name="left_finger_left">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4e-05" iyy="4e-05" izz="4e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="left_finger_left_joint" type="prismatic">
    <parent link="left_gripper" />
    <child link="left_finger_left" />
    <origin xyz="0 0.008 -0.04" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.025" effort="10" velocity="0.05" />
    <dynamics damping="1" />
  </joint>
  <link name="left_finger_right">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4e-05" iyy="4e-05" izz="4e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="left_finger_right_joint" type="prismatic">
    <parent link="left_gripper" />
    <child link="left_finger_right" />
    <origin xyz="0 -0.008 -0.04" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.025" effort="10" velocity="0.05" />
    <dynamics damping="1" />
  </joint>
  <link name="right_finger_left">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4e-05" iyy="4e-05" izz="4e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="right_finger_left_joint" type="prismatic">
    <parent link="right_gripper" />
    <child link="right_finger_left" />
    <origin xyz="0 0.008 -0.04" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.025" effort="10" velocity="0.05" />
    <dynamics damping="1" />
  </joint>
  <link name="right_finger_right">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.01 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4e-05" iyy="4e-05" izz="4e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="right_finger_right_joint" type="prismatic">
    <parent link="right_gripper" />
    <child link="right_finger_right" />
    <origin xyz="0 -0.008 -0.04" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.025" effort="10" velocity="0.05" />
    <dynamics damping="1" />
  </joint>
  <link name="laser_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.03" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="2.3125e-05" iyy="2.3125e-05" izz="3.125e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="laser_support_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_support" />
    <origin xyz="0 0 0.235" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.08 0.05" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.08 0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="camera_link_joint" type="fixed">
    <parent link="torso" />
    <child link="camera_link" />
    <origin xyz="0.20 0 0.65" rpy="0 0 0" />
  </joint>
  <link name="camera_optical_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-06" iyy="1e-06" izz="1e-06" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="camera_optical_frame_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
